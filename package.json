{
  "name": "riesgoti-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && node scripts/check-design-tokens.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "node e2e/support/run.mjs reuse --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:keep": "node e2e/support/run.mjs keep",
    "test:e2e:reuse": "node e2e/support/run.mjs reuse",
    "test:e2e:smoke": "node e2e/support/run.mjs off --project=smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@reduxjs/toolkit": "^2.13.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
